# Copie este arquivo para .env na raiz do projeto para usar com Docker Compose.
# O .env real é ignorado pelo Git. Substitua os valores de exemplo antes do uso.
# O backend executado diretamente carrega as variáveis de assinatura deste arquivo.
# Para banco, e-mail e armazenamento, exporte as variáveis ou configure-as na IDE.

# PostgreSQL: senha do administrador do container (usuário fixflow).
DB_PASSWORD=troque_a_senha_do_postgres
# Usuários separados para a aplicação e as migrações.
# Estas credenciais precisam corresponder aos papéis provisionados no banco.
DB_RUNTIME_USERNAME=fixflow_runtime
DB_RUNTIME_PASSWORD=troque_a_senha_runtime
DB_MIGRATOR_USERNAME=fixflow_migrator
DB_MIGRATOR_PASSWORD=troque_a_senha_migrator

# Anexos: valores para o LocalStack do Docker Compose.
ATTACHMENTS_ENABLED=true
S3_BUCKET=fixflow-attachments
S3_REGION=sa-east-1
S3_ENDPOINT=http://localstack-gateway:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566
# No Compose, S3_PATH_STYLE=true e as credenciais test são definidas no serviço app.

# Chave de 32 bytes em Base64 para proteger os links de orçamento enfileirados.
# Gere um valor próprio com: openssl rand -base64 32
QUOTE_LINK_ENCRYPTION_KEY=

# E-mails: Mailpit local. Caixa de entrada em http://localhost:8025.
# Para executar o backend fora do Docker, use SMTP_HOST=localhost.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=noreply@fixflow.local

# Assinaturas: habilite somente após preencher a integração escolhida.
# Com false, a contratação online fica indisponível.
SUBSCRIPTIONS_ENABLED=false
SUBSCRIPTIONS_PROVIDER=mercadopago
SUBSCRIPTION_STARTER_PRICE=69.90
SUBSCRIPTION_PROFESSIONAL_PRICE=119.90
SUBSCRIPTION_BUSINESS_PRICE=199.90

# Mercado Pago: obtenha as credenciais no painel da integração.
# O token de acesso e o segredo do webhook devem ser diferentes.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# BACK_URL usa o backend público e redireciona para APP_ORIGIN.
# URLs HTTPS públicas. Substitua o domínio de exemplo pelo seu domínio ou túnel.
MERCADOPAGO_BACK_URL=https://seu-dominio.example/public/subscriptions/return
MERCADOPAGO_NOTIFICATION_URL=https://seu-dominio.example/webhooks/mercadopago/subscriptions

# Provedor alternativo de assinaturas (SUBSCRIPTIONS_PROVIDER=asaas).
# Não confundir estas credenciais com a cobrança PIX de ordens de serviço.
SUBSCRIPTIONS_ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
SUBSCRIPTIONS_ASAAS_API_KEY=
SUBSCRIPTIONS_WEBHOOK_TOKEN=

# Variáveis adicionais para executar o backend diretamente.
# Estas opções não são repassadas pelo docker-compose.yaml atual.
# Para acesso ao banco fora do Docker, DB_PASSWORD deve ser a senha do runtime,
# e não a senha administrativa utilizada acima para criar o container PostgreSQL.
# DB_URL=jdbc:postgresql://localhost:5432/fixflow
# DB_USERNAME=fixflow_runtime
# APP_ORIGIN=http://localhost:4200
# AUTH_COOKIE_SECURE=false
# AUTH_PRIVATE_KEY=file:/caminho/privado/private.pem
# AUTH_PUBLIC_KEY=file:/caminho/privado/public.pem
# AUTH_KEY_ID=fixflow-rsa-1
# AUTH_ISSUER=fixflow
# FILE_STORAGE_ROOT=./storage
# SMTP_HEALTH_ENABLED=false
# S3_ENDPOINT=http://localhost:4566
# S3_PATH_STYLE=true
# S3_ACCESS_KEY=test
# S3_SECRET_KEY=test
# MERCADOPAGO_BASE_URL=https://api.mercadopago.com

# PIX das ordens de serviço: integração opcional e independente das assinaturas.
# Carregadas pelo backend local e repassadas ao serviço app no Docker Compose.
ASAAS_ENABLED=false
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
